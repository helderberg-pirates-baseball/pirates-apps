---
// Declining a booking the club can't take. Saving sets the status to
// Declined and keeps the reason; the booking's page then has the email to
// send the client.
import { actions, isInputError } from "astro:actions";
import Alert from "../../../components/Alert.astro";
import BackBar from "../../../components/BackBar.astro";
import AppLayout from "../../../layouts/AppLayout.astro";
import { loadBookingData } from "../../../lib/data";
import { DECLINE_REASONS } from "../../../lib/emails";

const { user } = Astro.locals;
const id = Astro.params.id ?? "";

const result = Astro.getActionResult(actions.declineBooking);
if (result && !result.error) {
  return Astro.redirect(`/bookings/${id}?done=declined`);
}
const saveError = result?.error
  ? isInputError(result.error)
    ? (result.error.issues[0]?.message ?? "Check the form and try again.")
    : result.error.message
  : undefined;

if (!user.permissions.notesAndStatus) {
  return Astro.redirect(`/bookings/${id}`);
}

const data = await loadBookingData();
const booking = data.bookings.find((b) => b.id === id);
if (!booking) {
  return Astro.redirect(`/bookings/${id}`);
}
const { outOfLineRows } = data.tracking;
---

<AppLayout title={`Decline ${booking.name || "booking"}`} user={user}>
  <BackBar href={`/bookings/${booking.id}`} label={booking.name || "Booking"} />

  <h1>Decline booking</h1>
  <p class="lede">
    {booking.name} · {booking.functionType}
  </p>

  {outOfLineRows.length > 0 && (
    <Alert tone="warning" title="Saving is paused">
      <p>
        "Tracking Data" no longer lines up with "Form responses 1" (row{" "}
        {outOfLineRows.join(", ")}). Ask an admin to line the rows up again.
      </p>
    </Alert>
  )}
  {saveError && (
    <Alert tone="danger" title="Not saved">
      {saveError}
    </Alert>
  )}

  <form class="form decline-form" method="POST" action={actions.declineBooking}>
    <input type="hidden" name="bookingId" value={booking.id} />

    <fieldset class="panel">
      <legend>
        <h2>Why can't the club take it?</h2>
      </legend>
      <label class="choice">
        <input type="radio" name="reason" value="booked" required />
        <span>
          Another booking at that time
          <small>"…{DECLINE_REASONS.booked}…"</small>
        </span>
      </label>
      <label class="choice">
        <input type="radio" name="reason" value="match" />
        <span>
          A match on that day
          <small>"…{DECLINE_REASONS.match}…"</small>
        </span>
      </label>
      <label class="choice">
        <input type="radio" name="reason" value="other" />
        <span>Something else</span>
      </label>
      <div class="field other-reason">
        <label for="otherReason">Finish the sentence</label>
        <textarea
          id="otherReason"
          name="otherReason"
          rows="1"
          data-grow
          maxlength="300"
          autocomplete="off"
          placeholder="the field is being resurfaced that week"
        />
        <p class="hint">
          The email reads: "Unfortunately <em>what you write</em>, so we're
          unable to accept your booking."
        </p>
      </div>
    </fieldset>

    <p class="hint">
      The status becomes Declined. Then the booking's page has the email to send
      them.
    </p>

    <div class="form-actions">
      <a class="button" href={`/bookings/${booking.id}`}>
        Cancel
      </a>
      <button
        class="button button-primary"
        type="submit"
        disabled={outOfLineRows.length > 0}
      >
        Decline booking
      </button>
    </div>
  </form>
</AppLayout>

<style>
  h1 {
    margin: 0;
    font-size: 1.625rem;
  }
  .lede {
    margin: 0.25rem 0 1rem;
    color: var(--color-muted);
  }
  :global(.alert) {
    margin-bottom: 1rem;
  }
  fieldset {
    margin: 0;
  }
  legend {
    float: left;
    width: 100%;
    padding: 0;
  }
  .choice {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-height: var(--tap-size);
    font-weight: 600;
    cursor: pointer;
  }
  .choice input {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    min-height: 0;
    margin: 0.125rem 0 0;
    accent-color: var(--color-primary);
  }
  .choice span {
    display: grid;
  }
  .choice small {
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 400;
  }

  /* The sentence box only shows for "Something else" */
  .other-reason {
    display: none;
  }
  .decline-form:has(input[value="other"]:checked) .other-reason {
    display: grid;
  }
</style>
