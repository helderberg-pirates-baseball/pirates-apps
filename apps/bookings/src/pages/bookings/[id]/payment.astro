---
// Recording money that came in from the client, or that the club paid back.
// The payment status and damage deposit it leads to are suggested as the
// form is filled in (see payment-statuses.ts), and can be changed before
// saving. Without JavaScript they start as suggested for the chosen kind,
// and don't follow the amount.
import { actions, isInputError } from "astro:actions";
import Alert from "../../../components/Alert.astro";
import BackBar from "../../../components/BackBar.astro";
import PaymentSummary from "../../../components/PaymentSummary.astro";
import AppLayout from "../../../layouts/AppLayout.astro";
import { loadBookingData } from "../../../lib/data";
import { suggestedStatuses } from "../../../lib/payment-statuses";
import { todayInSouthAfrica } from "../../../lib/dates";
import {
  currentInvoice,
  depositAmount,
  formatRand,
  invoiceTotal,
} from "../../../lib/invoices";
import {
  amountOverpaid,
  amountReceived,
  PAYMENT_KIND_LABELS,
  paymentsFor,
  type PaymentKind,
} from "../../../lib/payments";
import {
  DAMAGE_DEPOSIT_STATUSES,
  PAYMENT_STATUSES,
} from "../../../lib/tracking";

const { user } = Astro.locals;
const id = Astro.params.id ?? "";

const result = Astro.getActionResult(actions.recordPayment);
if (result && !result.error) {
  return Astro.redirect(`/bookings/${id}?done=payment-recorded#payments`);
}
const saveError = result?.error
  ? isInputError(result.error)
    ? (result.error.issues[0]?.message ?? "Check the form and try again.")
    : result.error.message
  : undefined;

if (!user.permissions.payments) {
  return Astro.redirect(`/bookings/${id}`);
}

const data = await loadBookingData();
const booking = data.bookings.find((b) => b.id === id);
if (!booking) {
  return Astro.redirect(`/bookings/${id}`);
}
const { outOfLineRows } = data.tracking;
const invoice = currentInvoice(data.invoices.invoices, booking.timestampKey);
const total = invoice ? invoiceTotal(invoice.lines) : 0;
const deposit = invoice ? depositAmount(invoice.lines) : 0;
const payments = paymentsFor(data.payments.payments, booking.timestampKey);
const received = amountReceived(payments);
const overpaid = amountOverpaid(received, total);

// The treasurer's list links here with ?kind=refund to pay back a damage
// deposit, ?kind=overpaid to pay back an overpayment, and ?kind=cancelled to
// settle a cancelled booking
const kindParam = Astro.url.searchParams.get("kind");
let chosenKind: PaymentKind = "Payment";
if (kindParam === "refund") {
  chosenKind = "Damage deposit refund";
} else if (kindParam === "overpaid" && overpaid > 0) {
  chosenKind = "Overpayment refund";
} else if (kindParam === "cancelled") {
  chosenKind = "Refund";
}
const { paymentStatus, damageDeposit } = booking.tracking;
const suggested = suggestedStatuses(
  { paymentStatus, damageDeposit },
  chosenKind,
  0,
  received,
  total
);
const statusFields = [
  {
    name: "paymentStatus",
    label: "Payment status",
    options: PAYMENT_STATUSES,
    current: paymentStatus,
  },
  {
    name: "damageDeposit",
    label: "Damage deposit",
    options: DAMAGE_DEPOSIT_STATUSES,
    current: damageDeposit,
  },
] as const;

const damageRefundHint =
  deposit > 0
    ? `After the function. The damage deposit becomes Refunded, and anything less than ${formatRand(deposit)} is kept back.`
    : "After the function. The damage deposit becomes Refunded.";
const amountHint =
  deposit > 0
    ? `Half the invoice is ${formatRand(total / 2)}; the damage deposit is ${formatRand(deposit)}.`
    : `Half the invoice is ${formatRand(total / 2)}.`;
---

<AppLayout
  title={`Record payment for ${booking.name || "booking"}`}
  user={user}
>
  <BackBar href={`/bookings/${booking.id}`} label={booking.name || "Booking"} />

  <h1>Record payment</h1>
  <p class="lede">
    {booking.name} · {booking.functionType}
  </p>

  {outOfLineRows.length > 0 && (
    <Alert tone="warning" title="Saving is paused">
      <p>
        "Tracking Data" no longer lines up with "Form responses 1" (row{" "}
        {outOfLineRows.join(", ")}). Ask an admin to line the rows up again.
      </p>
    </Alert>
  )}
  {saveError && (
    <Alert tone="danger" title="Not saved">
      {saveError}
    </Alert>
  )}

  <form
    class="form payment-form"
    method="POST"
    action={actions.recordPayment}
    data-received={received}
    data-total={total}
    data-payment-status={paymentStatus}
    data-damage-deposit={damageDeposit}
  >
    <input type="hidden" name="bookingId" value={booking.id} />

    <div class="panel">
      {invoice ? (
        <PaymentSummary
          invoice={invoice}
          payments={payments}
          tracking={booking.tracking}
        />
      ) : (
        <p class="so-far">
          No invoice yet, so the payment status won't move on its own.
        </p>
      )}
    </div>

    <fieldset class="panel">
      <legend>
        <h2>What happened?</h2>
      </legend>
      <label class="choice">
        <input
          type="radio"
          name="kind"
          value="Payment"
          checked={chosenKind === "Payment"}
        />
        <span>
          {PAYMENT_KIND_LABELS.Payment}
          <small>
            Half the invoice makes it Deposit Paid, all of it Full Payment
            Received.
          </small>
        </span>
      </label>
      <label class="choice">
        <input
          type="radio"
          name="kind"
          value="Damage deposit refund"
          checked={chosenKind === "Damage deposit refund"}
        />
        <span>
          {PAYMENT_KIND_LABELS["Damage deposit refund"]}
          <small>{damageRefundHint}</small>
        </span>
      </label>
      <label class="choice">
        <input
          type="radio"
          name="kind"
          value="Refund"
          checked={chosenKind === "Refund"}
        />
        <span>
          {PAYMENT_KIND_LABELS.Refund}
          <small>
            After a cancellation: whatever you pay back, or R0 to keep it all.
            The payment status becomes Refunded, which settles it.
          </small>
        </span>
      </label>
      {overpaid > 0 && (
        <label class="choice">
          <input
            type="radio"
            name="kind"
            value="Overpayment refund"
            checked={chosenKind === "Overpayment refund"}
          />
          <span>
            {PAYMENT_KIND_LABELS["Overpayment refund"]}
            <small>
              {formatRand(overpaid)} came in over the invoice. The payment
              status stays as it is.
            </small>
          </span>
        </label>
      )}
    </fieldset>

    <div class="panel">
      <div class="field">
        <label for="amount">Amount (R)</label>
        <input
          id="amount"
          name="amount"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          required
        />
        {invoice && <p class="hint">{amountHint}</p>}
      </div>
      <div class="field">
        <label for="paidOn">Date</label>
        <input
          id="paidOn"
          name="paidOn"
          type="date"
          value={todayInSouthAfrica()}
          required
        />
      </div>
      <div class="field">
        <label for="note">Reference or note (optional)</label>
        <input
          id="note"
          name="note"
          type="text"
          maxlength="300"
          autocomplete="off"
          placeholder="EFT, reference SMITH BDAY"
        />
      </div>
      <div class="field damage-note">
        <label for="damageNote">What was damaged (optional)</label>
        <textarea
          id="damageNote"
          name="damageNote"
          maxlength="2000"
          rows="3"
        ></textarea>
        <p class="hint">Only needed when some of the deposit is kept back.</p>
      </div>
    </div>

    <div class="panel">
      <h2>Statuses after this</h2>
      <p class="hint">
        Filled in from what you enter above. Change them if they should be
        different.
      </p>
      {statusFields.map((field) => (
        <div class="field">
          <label for={field.name}>{field.label}</label>
          <select id={field.name} name={field.name}>
            {field.options.map((option) => (
              <option
                value={option}
                selected={option === suggested[field.name]}
              >
                {option}
              </option>
            ))}
          </select>
          <p class="hint" data-status-hint={field.name}>
            {suggested[field.name] === field.current
              ? `Stays ${field.current}.`
              : `${field.current} → ${suggested[field.name]}.`}
          </p>
          <button
            class="use-suggested"
            type="button"
            data-use-suggested={field.name}
            hidden
          ></button>
        </div>
      ))}
    </div>

    <div class="form-actions">
      <a class="button" href={`/bookings/${booking.id}`}>
        Cancel
      </a>
      <button
        class="button button-primary"
        type="submit"
        disabled={outOfLineRows.length > 0}
      >
        Record payment
      </button>
    </div>
  </form>
</AppLayout>

<script>
  import { suggestedStatuses } from "../../../lib/payment-statuses";
  import type { PaymentKind } from "../../../lib/payments";

  // The statuses follow what's entered until someone picks one by hand.
  // "Use suggested" goes back to following.
  const form = document.querySelector<HTMLFormElement>(".payment-form");
  const amountInput = document.querySelector<HTMLInputElement>("#amount");

  function amountOf(typed: string): number {
    const cleaned = typed.replace(/[R\s]/gi, "").replace(",", ".");
    const amount = Number(cleaned);
    return Number.isFinite(amount) ? amount : 0;
  }

  if (form && amountInput) {
    const current = {
      paymentStatus: form.dataset.paymentStatus ?? "",
      damageDeposit: form.dataset.damageDeposit ?? "",
    };
    const received = Number(form.dataset.received);
    const total = Number(form.dataset.total);
    const fields = ["paymentStatus", "damageDeposit"] as const;
    const pickedByHand = { paymentStatus: false, damageDeposit: false };

    const suggestion = () => {
      const kind = form.querySelector<HTMLInputElement>(
        'input[name="kind"]:checked'
      )?.value as PaymentKind | undefined;
      return suggestedStatuses(
        current,
        kind ?? "Payment",
        amountOf(amountInput.value),
        received,
        total
      );
    };

    const update = () => {
      const suggested = suggestion();
      for (const field of fields) {
        const select = form.querySelector<HTMLSelectElement>(`#${field}`)!;
        const hint = form.querySelector(`[data-status-hint="${field}"]`)!;
        const reset = form.querySelector<HTMLButtonElement>(
          `[data-use-suggested="${field}"]`
        )!;
        if (!pickedByHand[field]) {
          select.value = suggested[field];
        }
        hint.textContent =
          select.value === current[field]
            ? `Stays ${current[field]}.`
            : `${current[field]} → ${select.value}.`;
        reset.hidden = select.value === suggested[field];
        reset.textContent = `Use suggested: ${suggested[field]}`;
      }
    };

    for (const field of fields) {
      form
        .querySelector<HTMLSelectElement>(`#${field}`)!
        .addEventListener("input", () => {
          // Runs before the form's own listener below, so it doesn't put
          // the suggestion back over what was just picked
          pickedByHand[field] = true;
        });
      form
        .querySelector<HTMLButtonElement>(`[data-use-suggested="${field}"]`)!
        .addEventListener("click", () => {
          pickedByHand[field] = false;
          update();
        });
    }
    form.addEventListener("input", update);
    form.addEventListener("change", update);
    update();
  }
</script>

<style>
  h1 {
    margin: 0;
    font-size: 1.625rem;
  }
  .lede {
    margin: 0.25rem 0 1rem;
    color: var(--color-muted);
  }
  :global(.alert) {
    margin-bottom: 1rem;
  }
  .so-far {
    margin: 0;
  }
  fieldset {
    margin: 0;
  }
  legend {
    float: left;
    width: 100%;
    padding: 0;
  }
  .choice {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-height: var(--tap-size);
    font-weight: 600;
    cursor: pointer;
  }
  .choice input {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    min-height: 0;
    margin: 0.125rem 0 0;
    accent-color: var(--color-primary);
  }
  .choice span {
    display: grid;
  }
  .choice small {
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 400;
  }

  .use-suggested {
    justify-self: start;
    min-height: var(--tap-size);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-primary);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }
  .use-suggested[hidden] {
    display: none;
  }

  /* The damage box only shows when paying back the damage deposit */
  .damage-note {
    display: none;
  }
  .payment-form:has(input[value="Damage deposit refund"]:checked) .damage-note {
    display: grid;
  }
</style>
