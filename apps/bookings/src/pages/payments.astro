---
// The treasurer's to-do list, for people with the Payments permission:
// invoices to make and send, money still to come in, and damage deposits to
// pay back. Each booking links straight to the next thing to do.
import Icon from "../components/Icon.astro";
import AppLayout from "../layouts/AppLayout.astro";
import { loadBookingData, type BookingData } from "../lib/data";
import {
  daysFromToday,
  relativeDay,
  shortDate,
  todayInSouthAfrica,
} from "../lib/dates";
import { depositAmount, formatRand } from "../lib/invoices";
import {
  paymentsTodo,
  totalOwing,
  type PaymentsTodo,
  type TodoItem,
} from "../lib/payments-todo";

const { user } = Astro.locals;
if (!user.permissions.payments) {
  return Astro.redirect("/");
}

const today = todayInSouthAfrica();

let data: BookingData | undefined;
try {
  data = await loadBookingData();
} catch (error) {
  console.error("Couldn't load the bookings", error);
}
const todo = data
  ? paymentsTodo(
      data.bookings,
      data.invoices.invoices,
      data.payments.payments,
      today
    )
  : undefined;

interface Section {
  key: keyof PaymentsTodo;
  title: string;
  /** What the link on each booking does */
  action: string;
  href: (item: TodoItem) => string;
  /** The line under the booking's name */
  detail: (item: TodoItem) => string;
  /** True when the money still owed is worth adding up */
  showsOwing?: boolean;
  /** True when the club pays money back: it isn't flagged as urgent */
  paysBack?: boolean;
}

const SECTIONS: Section[] = [
  {
    key: "needsInvoice",
    title: "Needs an invoice",
    action: "Create invoice",
    href: ({ booking }) => `/bookings/${booking.id}/invoice/edit`,
    detail: ({ booking }) =>
      `${booking.functionType || "No function type given"} · ${booking.tracking.status}`,
  },
  {
    key: "sentOutsideApp",
    title: "Invoice sent, not in the app",
    action: "Create invoice",
    href: ({ booking }) => `/bookings/${booking.id}/invoice/edit`,
    detail: ({ booking }) =>
      `${booking.tracking.invoiceNumber || "No invoice number"} · ${booking.functionType || "No function type given"}`,
  },
  {
    key: "notSent",
    title: "Invoice not sent",
    action: "Send invoice",
    href: ({ booking }) => `/bookings/${booking.id}/invoice`,
    detail: ({ invoice, total }) => `${invoice?.number} · ${formatRand(total)}`,
  },
  {
    key: "awaitingDeposit",
    title: "Waiting for the deposit",
    action: "Record payment",
    href: ({ booking }) => `/bookings/${booking.id}/payment`,
    detail: ({ invoice, owing }) =>
      `${formatRand(owing)} to confirm the booking · ${invoice?.number}`,
    showsOwing: true,
  },
  {
    key: "balanceOwing",
    title: "Balance owing",
    action: "Record payment",
    href: ({ booking }) => `/bookings/${booking.id}/payment`,
    detail: ({ invoice, received, owing }) =>
      `${formatRand(owing)} to come, ${formatRand(received)} received · ${invoice?.number}`,
    showsOwing: true,
  },
  {
    key: "depositToRefund",
    title: "Damage deposit to pay back",
    action: "Record refund",
    href: ({ booking }) => `/bookings/${booking.id}/payment?kind=refund`,
    detail: ({ invoice }) => {
      const deposit = invoice ? depositAmount(invoice.lines) : 0;
      return deposit > 0
        ? `${formatRand(deposit)} damage deposit`
        : "Damage deposit";
    },
    paysBack: true,
  },
  {
    key: "overpaid",
    title: "Overpaid: pay back the difference",
    action: "Record refund",
    href: ({ booking }) => `/bookings/${booking.id}/payment?kind=overpaid`,
    detail: ({ invoice, total, owing }) =>
      `${formatRand(owing)} over the ${formatRand(total)} invoice · ${invoice?.number}`,
    showsOwing: true,
    paysBack: true,
  },
  {
    key: "cancelledToSettle",
    title: "Cancelled: settle what was paid",
    action: "Record refund",
    href: ({ booking }) => `/bookings/${booking.id}/payment?kind=cancelled`,
    detail: ({ booking, received }) =>
      received > 0
        ? `${booking.tracking.status} · ${formatRand(received)} paid`
        : `${booking.tracking.status} · ${booking.tracking.paymentStatus}`,
    paysBack: true,
  },
];

// Money matters most close to the function, and once it's past
const isUrgent = (item: TodoItem) =>
  item.booking.date !== null && daysFromToday(item.booking.date, today) <= 7;

const shownSections = todo
  ? SECTIONS.filter((section) => todo[section.key].length > 0)
  : [];
---

<AppLayout title="Payments" user={user}>
  <h1>Payments</h1>
  <p class="lede">
    What still needs doing, soonest function first. Cancelled and declined
    bookings only show until what they paid is settled.
  </p>

  {!todo ? (
    <div class="empty" role="alert">
      <Icon name="alert" size={32} />
      <h2>Couldn't load the bookings</h2>
      <p>Check your connection and try again.</p>
      <a class="button" href="/payments">
        Try again
      </a>
    </div>
  ) : shownSections.length === 0 ? (
    <div class="empty">
      <Icon name="check" size={32} />
      <h2>Nothing to do</h2>
      <p>Every invoice is made, sent and paid.</p>
    </div>
  ) : (
    <>
      <nav class="overview" aria-label="Sections">
        {shownSections.map((section) => (
          <a href={`#${section.key}`}>
            <strong>{todo[section.key].length}</strong>
            <span>{section.title}</span>
            {section.showsOwing && (
              <small>{formatRand(totalOwing(todo[section.key]))}</small>
            )}
          </a>
        ))}
      </nav>

      {shownSections.map((section) => (
        <section class="section" id={section.key}>
          <h2>
            {section.title}
            <span class="count">{todo[section.key].length}</span>
          </h2>
          <ul class="items">
            {todo[section.key].map((item) => (
              <li>
                <a class="item" href={section.href(item)}>
                  <span class="who">
                    <strong>{item.booking.name || "No name given"}</strong>
                    <span>{section.detail(item)}</span>
                  </span>
                  <span class="when">
                    {item.booking.date ? (
                      <>
                        <span>{shortDate(item.booking.date)}</span>
                        <span
                          class:list={[
                            "tag",
                            {
                              "tag-warning":
                                !section.paysBack && isUrgent(item),
                            },
                          ]}
                        >
                          {relativeDay(item.booking.date, today)}
                        </span>
                      </>
                    ) : (
                      <span>No date</span>
                    )}
                  </span>
                  <span class="action">
                    {section.action}
                    <Icon name="chevron-right" size={18} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </>
  )}
</AppLayout>

<style>
  h1 {
    margin: 0;
    font-size: 1.625rem;
  }
  .lede {
    margin: 0.25rem 0 1rem;
    color: var(--color-muted);
  }

  .overview {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .overview a {
    display: grid;
    align-content: start;
    gap: 0.125rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    text-decoration: none;
  }
  .overview a:hover {
    border-color: var(--color-primary);
  }
  .overview strong {
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
  }
  .overview span {
    font-size: 0.875rem;
    font-weight: 600;
  }
  .overview small {
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .section {
    /* Clear of the sticky top bar when jumped to from the overview */
    scroll-margin-top: 4rem;
    margin-bottom: 1rem;
  }
  .section h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.75rem 0 0.5rem;
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .count {
    min-width: 1.5rem;
    padding: 0 0.375rem;
    border-radius: 999px;
    background: var(--color-surface-sunken);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    line-height: 1.5rem;
    text-align: center;
  }

  .items {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem 1rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    text-decoration: none;
  }
  .item:hover {
    border-color: var(--color-primary);
  }
  .who {
    display: grid;
    grid-column: 1 / -1;
    min-width: 0;
  }
  .who span {
    color: var(--color-muted);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }
  .tag-warning {
    background: var(--color-warning-soft);
    color: var(--color-warning);
  }
  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    color: var(--color-primary);
    font-size: 0.9375rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 3rem 1rem;
    color: var(--color-muted);
    text-align: center;
  }
  .empty h2 {
    margin: 0;
    color: var(--color-text);
    font-size: 1.125rem;
  }
  .empty p {
    margin: 0;
  }

  /* Wider screens: name, date and action side by side */
  @media (min-width: 48rem) {
    h1 {
      font-size: 2rem;
    }
    .item {
      grid-template-columns: minmax(0, 1fr) 13rem auto;
      align-items: center;
      padding: 0.75rem 1rem;
    }
    .who {
      grid-column: auto;
    }
  }
</style>
