---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Private app: keep it out of search results -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Pirates Bookings</title>

    <!-- Installable app: name, icons and colours are in the manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#c9491a" />
    <!--
      The colour the browser paints before the styles are applied, e.g. while
      pull-to-refresh reloads the page. Without it that's always white, which
      flashes in the dark theme. The script below sets the chosen theme.
    -->
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" href="/icons/icon-192.png" />
    <!-- iPhones use this icon, not the manifest's, on the home screen -->
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Bookings" />

    <!--
      Picks the light or dark theme before the page is drawn, so it never
      flashes the wrong one. The choice is "light", "dark" or "system" (follow
      the device), saved on this device only. The account menu calls
      window.setTheme to change it.
    -->
    <script is:inline>
      (function () {
        var STATUS_BAR_COLOURS = { light: "#c9491a", dark: "#1d1f24" };
        var systemDark = window.matchMedia("(prefers-color-scheme: dark)");

        function savedChoice() {
          try {
            return localStorage.getItem("theme") || "system";
          } catch (error) {
            return "system";
          }
        }

        function setMeta(name, content) {
          var meta = document.querySelector('meta[name="' + name + '"]');
          if (meta) meta.setAttribute("content", content);
        }

        function apply(choice) {
          var dark =
            choice === "dark" || (choice === "system" && systemDark.matches);
          var theme = dark ? "dark" : "light";
          document.documentElement.dataset.theme = theme;
          setMeta("theme-color", STATUS_BAR_COLOURS[theme]);
          setMeta("color-scheme", theme);
        }

        window.setTheme = function (choice) {
          try {
            localStorage.setItem("theme", choice);
          } catch (error) {
            // Private browsing can block saving; the theme still changes now
          }
          apply(choice);
        };
        window.savedTheme = savedChoice;

        systemDark.addEventListener("change", function () {
          if (savedChoice() === "system") apply("system");
        });
        apply(savedChoice());
      })();
    </script>
  </head>
  <body>
    <div class="loading-bar" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<script>
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register("/sw.js");
  }
</script>

<script>
  // While the next page loads (reading the sheet can take a few seconds),
  // show a progress bar, dim the page so it doesn't look ready, and put a
  // spinner on whatever was tapped. A form can't be sent twice.
  const root = document.documentElement;

  function startLoading(tapped: Element) {
    root.dataset.loading = "";
    tapped.setAttribute("aria-busy", "true");
    document.querySelector("main")?.setAttribute("aria-busy", "true");
    // If the next page never arrives (the connection dropped), let people
    // try again
    window.setTimeout(stopLoading, 20_000);
  }

  function stopLoading() {
    delete root.dataset.loading;
    for (const element of document.querySelectorAll("[aria-busy]")) {
      element.removeAttribute("aria-busy");
    }
    for (const form of document.querySelectorAll<HTMLFormElement>(
      "form[data-sending]"
    )) {
      delete form.dataset.sending;
    }
  }

  document.addEventListener("click", (event) => {
    const opensElsewhere =
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey;
    const link = (event.target as Element).closest("a");
    if (
      opensElsewhere ||
      !link ||
      link.target === "_blank" ||
      link.hasAttribute("download") ||
      // Files that open in another app, like a calendar event
      link.hasAttribute("data-no-loading")
    ) {
      return;
    }
    const url = new URL(link.href);
    // Other sites, and phone and email links, don't load a page here
    const isOtherSite = url.origin !== location.origin;
    const isSamePage =
      url.pathname === location.pathname && url.search === location.search;
    if (!isOtherSite && !isSamePage) {
      startLoading(link);
    }
  });

  document.addEventListener("submit", (event) => {
    const form = event.target as HTMLFormElement;
    if (form.dataset.sending !== undefined) {
      // A second tap while the first is still sending
      event.preventDefault();
      return;
    }
    form.dataset.sending = "";
    startLoading(event.submitter ?? form);
  });

  // Going back can show the previous page from the browser's memory, still
  // in its loading state
  window.addEventListener("pageshow", stopLoading);
</script>

<script>
  // A one-line text that wraps as it's typed (textarea[data-grow]), so a long
  // description is easy to read and edit on a phone. It stays one line of
  // text: Enter does nothing and pasted line breaks become spaces. Browsers
  // without CSS field-sizing grow it here.
  const growsItself = CSS.supports("field-sizing", "content");

  function grow(box: HTMLTextAreaElement) {
    if (growsItself) return;
    box.style.height = "";
    box.style.height = `${box.scrollHeight + 2}px`;
  }

  function isGrowBox(
    target: EventTarget | null
  ): target is HTMLTextAreaElement {
    return (
      target instanceof HTMLTextAreaElement && target.hasAttribute("data-grow")
    );
  }

  document.addEventListener("keydown", (event) => {
    if (event.key === "Enter" && isGrowBox(event.target)) {
      event.preventDefault();
    }
  });

  document.addEventListener("input", (event) => {
    const box = event.target;
    if (!isGrowBox(box)) return;
    if (/[\r\n]/.test(box.value)) {
      const end = box.selectionEnd;
      box.value = box.value.replace(/\s*[\r\n]+\s*/g, " ");
      box.setSelectionRange(end, end);
    }
    grow(box);
  });

  const growAll = () => {
    for (const box of document.querySelectorAll<HTMLTextAreaElement>(
      "textarea[data-grow]"
    )) {
      grow(box);
    }
  };
  growAll();
  // Widths change when the phone turns
  window.addEventListener("resize", growAll);
</script>
