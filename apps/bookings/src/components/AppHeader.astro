---
import type { SignedInUser } from "../lib/users";
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  user: SignedInUser;
}

const { user } = Astro.props;
const initial = (user.name || user.email).trim().charAt(0).toUpperCase();
const path = Astro.url.pathname.replace(/\/$/, "");
const onPaymentsPage = path === "/payments";
const onInvoicesPage = path === "/invoices" || path.startsWith("/invoices/");

const THEMES: { value: ThemeChoice; label: string; icon: IconName }[] = [
  { value: "system", label: "System", icon: "monitor" },
  { value: "light", label: "Light", icon: "sun" },
  { value: "dark", label: "Dark", icon: "moon" },
];
---

<header class="app-bar">
  <div class="app-bar-inner">
    <a class="brand" href="/">
      <img src="/icons/icon-192.png" alt="" width="32" height="32" />
      <span>Bookings</span>
    </a>

    <div class="app-bar-end">
      {user.permissions.payments && (
        <>
          <a
            class="nav-link"
            href="/payments"
            title="Payments"
            aria-current={onPaymentsPage ? "page" : undefined}
          >
            <Icon name="banknote" size={18} />
            <span class="nav-label">Payments</span>
          </a>
          <a
            class="nav-link"
            href="/invoices"
            title="Invoices"
            aria-current={onInvoicesPage ? "page" : undefined}
          >
            <Icon name="file" size={18} />
            <span class="nav-label">Invoices</span>
          </a>
        </>
      )}

      <details class="account" data-account-menu>
        <summary class="avatar" aria-label="Account and theme">
          {initial}
        </summary>
        <div class="menu">
          <div class="who">
            <strong>{user.name}</strong>
            <span>{user.email}</span>
          </div>

          <fieldset class="theme-picker">
            <legend>Theme</legend>
            <div class="theme-options">
              {THEMES.map((theme) => (
                <label>
                  <input
                    class="visually-hidden"
                    type="radio"
                    name="theme"
                    value={theme.value}
                    data-theme-choice
                  />
                  <Icon name={theme.icon} size={18} />
                  <span>{theme.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <form method="post" action="/logout">
            <button class="sign-out" type="submit">
              <Icon name="log-out" size={18} />
              Sign out
            </button>
          </form>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // The theme picker shows the saved choice, and saves a new one
  for (const input of document.querySelectorAll<HTMLInputElement>(
    "[data-theme-choice]"
  )) {
    input.checked = input.value === window.savedTheme();
    input.addEventListener("change", () =>
      window.setTheme(input.value as ThemeChoice)
    );
  }

  // The account menu closes when you tap outside it or press Escape
  const menu = document.querySelector<HTMLDetailsElement>(
    "[data-account-menu]"
  );
  document.addEventListener("click", (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) {
      menu.open = false;
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
</script>

<style>
  .app-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-app-bar);
    color: var(--color-on-app-bar);
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 40%, transparent);
  }
  .app-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space);
    max-width: 64rem;
    min-height: 3.5rem;
    margin-inline: auto;
    padding: 0.5rem var(--space);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: inherit;
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
  }
  .brand img {
    border-radius: 50%;
    background: #ffffff;
  }

  .app-bar-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }
  /* On the narrowest phones the links show only their icons */
  @media (max-width: 24rem) {
    .nav-label {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    background: color-mix(in srgb, var(--color-on-app-bar) 18%, transparent);
  }

  .account {
    position: relative;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-on-app-bar) 18%, transparent);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .avatar::-webkit-details-marker {
    display: none;
  }
  .account[open] .avatar {
    background: color-mix(in srgb, var(--color-on-app-bar) 30%, transparent);
  }

  .menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    display: grid;
    gap: var(--space);
    width: min(18rem, calc(100vw - 2rem));
    padding: var(--space);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.18);
  }
  .who {
    display: grid;
    min-width: 0;
  }
  .who span {
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-overflow: ellipsis;
  }

  .theme-picker {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .theme-picker legend {
    margin-bottom: 0.375rem;
    padding: 0;
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .theme-options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: var(--radius-small);
    background: var(--color-surface-sunken);
  }
  .theme-options label {
    display: grid;
    justify-items: center;
    gap: 0.125rem;
    padding: 0.5rem 0.25rem;
    border-radius: 0.375rem;
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }
  .theme-options label:has(input:checked) {
    background: var(--color-surface);
    color: var(--color-primary);
    box-shadow: var(--shadow-card);
  }
  .theme-options label:has(input:focus-visible) {
    outline: 2px solid var(--color-primary);
  }

  .sign-out {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background: none;
    font-weight: 600;
    cursor: pointer;
  }
  .sign-out:hover {
    background: var(--color-surface-sunken);
  }
</style>
