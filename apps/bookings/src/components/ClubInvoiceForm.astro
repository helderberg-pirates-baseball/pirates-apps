---
// The form for an invoice for other club business: its number, who it's
// for, and its lines. Opens with the saved invoice, an empty one, or what
// was typed when saving failed.
import { actions } from "astro:actions";
import {
  MAX_CLUB_INVOICE_LINES,
  type ClubInvoiceFormValues,
} from "../lib/club-invoices";
import { MAX_VALID_DAYS, type Invoice } from "../lib/invoices";
import Help from "./Help.astro";
import Icon from "./Icon.astro";

interface Props {
  /** The invoice being changed, or undefined for a new one */
  invoice: Invoice | undefined;
  /** What the form opens with */
  values: ClubInvoiceFormValues;
  /** The number the form suggested: a draft's own, or the next in line */
  suggestedNumber: string;
}

const { invoice, values, suggestedNumber } = Astro.props;
// The form always ends with a blank line, so blank ones sent with a failed
// save are left out
const lines = values.description
  .map((description, index) => ({
    description,
    amount: values.amount[index] ?? "",
  }))
  .filter((line) => line.description.trim() || line.amount.trim());
const shownLines =
  lines.length < MAX_CLUB_INVOICE_LINES
    ? [...lines, { description: "", amount: "" }]
    : lines;

// Amounts as typed: "3500", "3 500", "R3500" or "3500,50"
const AMOUNT_PATTERN = "\\s*[Rr]?[\\d\\s]*([.,]\\d{1,2})?\\s*";
---

<form
  class="form club-invoice-form"
  method="POST"
  action={actions.saveClubInvoice}
>
  <input type="hidden" name="shownNumber" value={invoice?.number ?? ""} />

  <section class="panel">
    <h2>Invoice number and date</h2>
    <input type="hidden" name="suggestedNumber" value={suggestedNumber} />
    <div class="field">
      <Help about="Number">
        <label for="number">Number</label>
        <Fragment slot="help">
          Like INV-20261013-001: the date as yyyyMMdd, then three digits. It
          shares one run of numbers with the bookings' invoices.
        </Fragment>
      </Help>
      <div class="number-row">
        <input
          id="number"
          name="number"
          type="text"
          value={values.number}
          required
          maxlength="16"
          pattern="INV-\d{8}-\d{3}"
          autocomplete="off"
        />
        {/* Shown while the number isn't the suggested one, and only with JavaScript */}
        <button
          class="reset-number"
          type="button"
          aria-label={`Use ${suggestedNumber}`}
          title={`Use ${suggestedNumber}`}
          data-reset-number={suggestedNumber}
          hidden
        >
          <Icon name="refresh" size={18} />
        </button>
      </div>
    </div>
    <div class="field">
      <Help about="Invoice date">
        <label for="issuedOn">Invoice date</label>
        <Fragment slot="help">
          Move it to the day you'll send the invoice if that's later. Any
          validity period counts from it.
        </Fragment>
      </Help>
      <input
        id="issuedOn"
        name="issuedOn"
        type="date"
        value={values.issuedOn}
        required
      />
    </div>
    <div class="field">
      <Help about="Valid for">
        <label for="validDays">Valid for (days, optional)</label>
        <Fragment slot="help">
          Adds a note that the invoice is only valid for this many days from the
          invoice date, with the last day. Leave it empty to leave the note off.
        </Fragment>
      </Help>
      <input
        id="validDays"
        name="validDays"
        type="number"
        inputmode="numeric"
        min="1"
        max={MAX_VALID_DAYS}
        step="1"
        value={values.validDays}
      />
    </div>
  </section>

  <section class="panel">
    <h2>Bill to</h2>
    <div class="field">
      <Help about="Name">
        <label for="customer">Name</label>
        <Fragment slot="help">A person, or the business's name.</Fragment>
      </Help>
      <input
        id="customer"
        name="customer"
        type="text"
        value={values.customer}
        required
        maxlength="200"
        autocomplete="off"
      />
    </div>
    <div class="field">
      <Help about="Contact name">
        <label for="contactName">Contact name (optional)</label>
        <Fragment slot="help">
          When the invoice is for a business: the person to address it to. Leave
          it empty for a person.
        </Fragment>
      </Help>
      <input
        id="contactName"
        name="contactName"
        type="text"
        value={values.contactName}
        maxlength="200"
        autocomplete="off"
      />
    </div>
    <div class="field">
      <label for="address">Address (optional)</label>
      <textarea
        id="address"
        name="address"
        rows="3"
        maxlength="500"
        set:text={values.address}
      />
    </div>
    <div class="field">
      <label for="regNumber">Company registration number (optional)</label>
      <input
        id="regNumber"
        name="regNumber"
        type="text"
        value={values.regNumber}
        maxlength="100"
        autocomplete="off"
      />
    </div>
    <div class="field">
      <Help about="VAT number">
        <label for="vatNumber">VAT number (optional)</label>
        <Fragment slot="help">
          Only printed on the invoice when filled in.
        </Fragment>
      </Help>
      <input
        id="vatNumber"
        name="vatNumber"
        type="text"
        value={values.vatNumber}
        maxlength="100"
        autocomplete="off"
      />
    </div>
    <div class="field">
      <label for="phone">Phone (optional)</label>
      <input
        id="phone"
        name="phone"
        type="tel"
        value={values.phone}
        maxlength="50"
        autocomplete="off"
      />
    </div>
    <div class="field">
      <label for="email">Email (optional)</label>
      <input
        id="email"
        name="email"
        type="email"
        value={values.email}
        maxlength="200"
        autocomplete="off"
      />
    </div>
  </section>

  <section class="panel">
    <Help about="Lines">
      <h2>Lines</h2>
      <Fragment slot="help">Leave a line empty to skip it.</Fragment>
    </Help>
    <div class="lines" data-lines data-max-lines={MAX_CLUB_INVOICE_LINES}>
      {shownLines.map((line) => (
        <div class="line" data-line>
          <div class="field">
            <label>
              <span>Description</span>
              {/* Wraps and grows as it's typed, but stays one line */}
              <textarea
                name="description"
                rows="1"
                maxlength="300"
                autocomplete="off"
                data-grow
                set:text={line.description}
              />
            </label>
          </div>
          <div class="line-bottom">
            <div class="field amount">
              <label>
                <span>Amount (R)</span>
                <input
                  name="amount"
                  type="text"
                  inputmode="decimal"
                  pattern={AMOUNT_PATTERN}
                  value={line.amount}
                  maxlength="20"
                  autocomplete="off"
                  data-amount
                />
              </label>
            </div>
            <button
              class="remove"
              type="button"
              aria-label="Remove this line"
              data-remove-line
              hidden
            >
              <Icon name="trash" size={18} />
            </button>
          </div>
        </div>
      ))}
    </div>
    <button class="button" type="button" data-add-line hidden>
      Add a line
    </button>
  </section>

  <section class="panel">
    <h2>Signature</h2>
    <div class="field">
      <Help about="Your title">
        <label for="signerTitle">Your title</label>
        <Fragment slot="help">
          The invoice is signed in your name, {Astro.locals.user.name}, with
          this title under it.
        </Fragment>
      </Help>
      <input
        id="signerTitle"
        name="signerTitle"
        type="text"
        value={values.signerTitle}
        required
        maxlength="100"
        autocomplete="organization-title"
      />
    </div>
  </section>

  <p class="total" data-total-row hidden>
    Total <strong data-total></strong>
  </p>

  <div class="form-actions">
    <a
      class="button"
      href={invoice ? `/invoices/${invoice.number}` : "/invoices"}
    >
      Cancel
    </a>
    <button class="button button-primary" type="submit">
      {invoice ? "Save" : "Create invoice"}
    </button>
  </div>
</form>

<script>
  // Switching back to the suggested invoice number after changing it
  const numberInput = document.querySelector<HTMLInputElement>("#number");
  const resetNumber = document.querySelector<HTMLButtonElement>(
    "[data-reset-number]"
  );
  if (numberInput && resetNumber) {
    const suggested = resetNumber.dataset.resetNumber!;
    const updateResetButton = () => {
      resetNumber.hidden = numberInput.value === suggested;
    };
    resetNumber.addEventListener("click", () => {
      numberInput.value = suggested;
      updateResetButton();
      numberInput.focus();
    });
    numberInput.addEventListener("input", updateResetButton);
    updateResetButton();
  }

  // Adding and removing lines, and a running total. Without JavaScript the
  // form still works: there's one blank line per save.
  const form = document.querySelector<HTMLFormElement>(".club-invoice-form");

  function amountOf(typed: string): number {
    const cleaned = typed.replace(/[R\s]/gi, "").replace(",", ".");
    const amount = Number(cleaned);
    return Number.isFinite(amount) ? amount : 0;
  }

  if (form) {
    const lines = form.querySelector<HTMLElement>("[data-lines]")!;
    const maxLines = Number(lines.dataset.maxLines);
    const addLine = form.querySelector<HTMLButtonElement>("[data-add-line]")!;
    const totalRow = form.querySelector<HTMLElement>("[data-total-row]")!;
    const total = form.querySelector<HTMLElement>("[data-total]")!;

    const updateTotal = () => {
      const sum = [...form.querySelectorAll<HTMLInputElement>("[data-amount]")]
        .map((input) => amountOf(input.value))
        .reduce((a, b) => a + b, 0);
      total.textContent = `R ${sum.toLocaleString("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      })}`;
    };

    const updateLineButtons = () => {
      for (const remove of lines.querySelectorAll<HTMLButtonElement>(
        "[data-remove-line]"
      )) {
        remove.hidden = false;
      }
      addLine.hidden = lines.querySelectorAll("[data-line]").length >= maxLines;
    };

    addLine.addEventListener("click", () => {
      const template = lines.querySelector<HTMLElement>("[data-line]")!;
      const line = template.cloneNode(true) as HTMLElement;
      for (const input of line.querySelectorAll<
        HTMLInputElement | HTMLTextAreaElement
      >("input, textarea")) {
        input.value = "";
        input.style.height = "";
      }
      lines.append(line);
      updateLineButtons();
      line.querySelector("textarea")?.focus();
    });

    lines.addEventListener("click", (event) => {
      const remove = (event.target as Element).closest("[data-remove-line]");
      if (!remove) return;
      const line = remove.closest<HTMLElement>("[data-line]")!;
      // Keep one line to type into, emptied
      if (lines.querySelectorAll("[data-line]").length === 1) {
        for (const input of line.querySelectorAll<
          HTMLInputElement | HTMLTextAreaElement
        >("input, textarea")) {
          input.value = "";
          input.style.height = "";
        }
      } else {
        line.remove();
      }
      updateLineButtons();
      updateTotal();
    });

    form.addEventListener("input", updateTotal);
    updateLineButtons();
    updateTotal();
    totalRow.hidden = false;
  }
</script>

<style>
  .lines {
    display: grid;
    gap: 1rem;
  }
  /* On phones a line stacks: the description on its own, then the amount
     and Remove. Wider screens fit it on one row. The labels wrap their
     fields, so a copied line needs no new IDs. */
  .line {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem;
    border-radius: var(--radius-small);
    background: var(--color-surface-sunken);
  }
  .line-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.5rem;
  }
  @media (min-width: 40rem) {
    .line {
      grid-template-columns: minmax(0, 1fr) 9rem auto;
      align-items: end;
      padding: 0;
      background: none;
    }
    .line-bottom {
      display: contents;
    }
  }
  .remove {
    display: grid;
    place-items: center;
    width: var(--tap-size);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background: var(--color-surface);
    color: var(--color-danger);
    cursor: pointer;
  }
  .remove[hidden] {
    display: none;
  }
  .number-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
  }
  .reset-number {
    display: grid;
    place-items: center;
    width: var(--tap-size);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background: var(--color-surface);
    color: var(--color-primary);
    cursor: pointer;
  }
  .reset-number:hover {
    border-color: var(--color-primary);
  }
  .reset-number[hidden] {
    display: none;
  }
  .club-invoice-form [data-add-line] {
    justify-self: start;
  }
  .club-invoice-form [data-add-line][hidden] {
    display: none;
  }

  .total {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 0 1rem;
    font-size: 1.125rem;
  }
  .total[hidden] {
    display: none;
  }
</style>
