---
// A field's label (or a section's heading) with a ? next to it. Tapping the ?
// opens a short note about the field under the label, and tapping it again,
// anywhere else, or pressing Escape closes it. One note is open at a time.
// The ? needs JavaScript, so without it only the label shows.
//
//   <Help about="Number">
//     <label for="number">Number</label>
//     <Fragment slot="help">Like INV-20261013-001…</Fragment>
//   </Help>
interface Props {
  /** What the note is about, read out as "About …" by screen readers */
  about: string;
}

const { about } = Astro.props;
const id = `help-${about.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<div class="help-row">
  <slot />
  <button
    class="help-button"
    type="button"
    aria-label={`About ${about}`}
    aria-expanded="false"
    aria-controls={id}
    data-help
    hidden
  >
    ?
  </button>
  <p class="help-note" id={id} role="note" hidden>
    <slot name="help" />
  </p>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-help]");

  function note(button: HTMLButtonElement) {
    return document.getElementById(button.getAttribute("aria-controls")!)!;
  }

  function closeAll(except?: HTMLButtonElement) {
    for (const button of buttons) {
      if (button === except) continue;
      button.setAttribute("aria-expanded", "false");
      note(button).hidden = true;
    }
  }

  for (const button of buttons) {
    button.hidden = false;
    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") === "true";
      closeAll(button);
      button.setAttribute("aria-expanded", String(!open));
      note(button).hidden = open;
    });
  }

  // Tapping anywhere but a ? or an open note closes it
  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    if (!target.closest("[data-help], .help-note")) closeAll();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const open = [...buttons].find(
      (button) => button.getAttribute("aria-expanded") === "true"
    );
    if (!open) return;
    closeAll();
    open.focus();
  });
</script>

<style>
  .help-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
  }

  /* Labels look as they do on top of a field without a ? */
  .help-row > :global(label:not(.checkbox)) {
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  /* Small to look at, but with a finger-sized tap area around it */
  .help-button {
    position: relative;
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    min-width: 0;
    min-height: 0;
    padding: 0;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    background: none;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }
  .help-button::after {
    content: "";
    position: absolute;
    inset: -0.5rem;
  }
  .help-button[hidden] {
    display: none;
  }
  .help-button:hover,
  .help-button[aria-expanded="true"] {
    color: var(--color-primary);
  }
  .help-button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .help-note {
    flex-basis: 100%;
    margin: 0.125rem 0 0.25rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-small);
    background: var(--color-surface-sunken);
    color: var(--color-text);
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .help-note[hidden] {
    display: none;
  }
</style>
