---
// Everything about one booking: when, how to reach the person, where it
// stands, their answers on the form, and its history
import { actions } from "astro:actions";
import {
  durationInMinutes,
  durationLabel,
  formatPhone,
  timeRange,
} from "../lib/bookings";
import { longDate, relativeDay, shortDate, shortDateTime } from "../lib/dates";
import { declineEmail } from "../lib/emails";
import type { HistoryEntry } from "../lib/history";
import type { Invoice } from "../lib/invoices";
import type { Payment } from "../lib/payments";
import {
  canDeleteIdNumber,
  editableFields,
  isCalledOff,
  isConfirmed,
  type TrackedBooking,
} from "../lib/tracking";
import type { SignedInUser } from "../lib/users";
import Alert from "./Alert.astro";
import BookingHistory from "./BookingHistory.astro";
import CopyButton from "./CopyButton.astro";
import EmailTools from "./EmailTools.astro";
import Icon from "./Icon.astro";
import PaymentsPanel from "./PaymentsPanel.astro";
import StatusTag from "./StatusTag.astro";

interface Props {
  booking: TrackedBooking;
  today: string;
  user: SignedInUser;
  /** Other confirmed bookings on the same date */
  clashes: TrackedBooking[];
  history: HistoryEntry[];
  /** The booking's current invoice, if it has one */
  invoice: Invoice | undefined;
  /** The booking's payments, oldest first */
  payments: Payment[];
  /** Now, as a Sheets date-and-time number */
  now: number;
  /** A note that couldn't be saved */
  noteError?: string;
}

const {
  booking,
  today,
  user,
  clashes,
  history,
  invoice,
  payments,
  now,
  noteError,
} = Astro.props;
const { tracking } = booking;
const time = timeRange(booking);
const duration = durationInMinutes(booking);
const phone = formatPhone(booking.phone);
const allContactDetails = [booking.name, phone, booking.email]
  .filter(Boolean)
  .join("\n");
const isPast = booking.date !== null && booking.date < today;
const canEdit = editableFields(user.permissions).length > 0;
const canDecline = user.permissions.notesAndStatus && !isCalledOff(tracking);
const isDeclined = tracking.status === "Declined";
// A shortcut for the usual first step, without opening the edit form
const canMarkContacted =
  user.permissions.notesAndStatus && tracking.status === "New";
// The app never shows ID numbers (they're in the sheet if needed). People
// who can edit booking details see whether one is on file, and can delete it
// once the club no longer needs it.
const canDeleteIdNumbers = user.permissions.editDetails;
const showDeleteIdNumber =
  canDeleteIdNumbers && canDeleteIdNumber(booking, today);
const submitted = booking.submittedDate
  ? `${shortDate(booking.submittedDate)}${booking.submittedTime ? `, ${booking.submittedTime}` : ""}`
  : "Unknown";
const lastSavedBy =
  tracking.updatedBy.toLowerCase() === user.email.toLowerCase()
    ? "you"
    : tracking.updatedBy;
---

<article class="booking">
  <header class="heading">
    <div class="heading-text">
      <h1>{booking.name || "No name given"}</h1>
      <p class="function">{booking.functionType || "No function type given"}</p>
      <div class="tags">
        {isConfirmed(tracking) && <StatusTag status="Confirmed" />}
        <StatusTag status={tracking.status} />
        {booking.isMember && <span class="tag">Club member</span>}
        {isPast && <span class="tag">Past</span>}
      </div>
    </div>
    <div class="heading-buttons">
      <button
        class="button"
        type="button"
        data-share-booking
        data-path={`/bookings/${booking.id}`}
        data-title={booking.name || "Booking"}
      >
        <Icon name="share" size={18} />
        <span data-share-label>Share</span>
      </button>
      {canDecline && (
        <a class="button" href={`/bookings/${booking.id}/decline`}>
          <Icon name="x" size={18} />
          Decline
        </a>
      )}
      {canEdit && (
        <a class="button" href={`/bookings/${booking.id}/edit`}>
          <Icon name="edit" size={18} />
          Edit
        </a>
      )}
    </div>
  </header>

  {isDeclined && tracking.declineReason && (
    <section class="panel">
      <h2>Let them know</h2>
      <p class="declined">Declined because {tracking.declineReason}.</p>
      <EmailTools email={declineEmail(booking, tracking.declineReason)} />
    </section>
  )}

  {clashes.length > 0 && booking.date && (
    <Alert tone="warning" title="This date is already taken">
      <p>
        {clashes.length === 1
          ? "Another booking is"
          : `${clashes.length} other bookings are`}{" "}
        confirmed on {longDate(booking.date)}:{" "}
        {clashes.map((other, index) => (
          <>
            {index > 0 && ", "}
            <a href={`/bookings/${other.id}`}>
              {other.name || "No name given"}
              {timeRange(other) && ` (${timeRange(other)})`}
            </a>
          </>
        ))}
      </p>
    </Alert>
  )}

  <div class="columns">
    <div class="column">
      <section class="panel" aria-label="When">
        <div class="when-row">
          <span class="when-icon">
            <Icon name="calendar" />
          </span>
          <div>
            <strong>
              {booking.date ? longDate(booking.date) : "No date given"}
            </strong>
            {booking.date && <span>{relativeDay(booking.date, today)}</span>}
          </div>
          {booking.date && (
            <a
              class="add-to-calendar"
              href={`/bookings/${booking.id}/calendar.ics`}
              aria-label="Add to calendar"
              title="Add to calendar"
              data-no-loading
            >
              <Icon name="calendar-plus" />
            </a>
          )}
        </div>
        <div class="when-row">
          <span class="when-icon">
            <Icon name="clock" />
          </span>
          <div>
            <strong>{time ?? "No time given"}</strong>
            {duration !== null && (
              <span>
                {durationLabel(duration)}
                {booking.endsNextDay && " · ends the next day"}
              </span>
            )}
          </div>
        </div>
      </section>

      <section class="panel">
        <h2>Contact</h2>
        <dl class="rows">
          <div class="row">
            <dt>Name</dt>
            <dd>
              <span class="value">{booking.name || "—"}</span>
              {booking.name && <CopyButton value={booking.name} label="name" />}
            </dd>
          </div>
          <div class="row">
            <dt>Phone</dt>
            <dd>
              {booking.phone ? (
                <a
                  class="value"
                  href={`tel:${booking.phone.replace(/[^\d+]/g, "")}`}
                >
                  {phone}
                </a>
              ) : (
                <span class="value">—</span>
              )}
              {booking.phone && (
                <CopyButton value={phone} label="phone number" />
              )}
            </dd>
          </div>
          <div class="row">
            <dt>Email</dt>
            <dd>
              {booking.email ? (
                <a class="value" href={`mailto:${booking.email}`}>
                  {booking.email}
                </a>
              ) : (
                <span class="value">—</span>
              )}
              {booking.email && (
                <CopyButton value={booking.email} label="email address" />
              )}
            </dd>
          </div>
        </dl>
        <CopyButton
          value={allContactDetails}
          label="all contact details"
          text="Copy all contact details"
        />
        {canMarkContacted && (
          <form
            class="contacted-form"
            method="POST"
            action={actions.markClientContacted}
          >
            <input type="hidden" name="bookingId" value={booking.id} />
            <button class="button" type="submit">
              <Icon name="check" size={18} />
              Mark as client contacted
            </button>
          </form>
        )}
      </section>

      <section class="panel">
        <h2>Tracking</h2>
        <dl class="rows">
          <div class="row">
            <dt>Status</dt>
            <dd>
              <span class="value">{tracking.status}</span>
            </dd>
          </div>
          {isDeclined && tracking.declineReason && (
            <div class="row">
              <dt>Why declined</dt>
              <dd>
                <span class="value">{tracking.declineReason}</span>
              </dd>
            </div>
          )}
          <div class="row">
            <dt>Payment status</dt>
            <dd>
              <span class="value">{tracking.paymentStatus}</span>
            </dd>
          </div>
          <div class="row">
            <dt>Invoice number</dt>
            <dd>
              <span class="value">{tracking.invoiceNumber || "—"}</span>
            </dd>
          </div>
          <div class="row">
            <dt>Damage deposit</dt>
            <dd>
              <span class="value">{tracking.damageDeposit}</span>
            </dd>
          </div>
          {tracking.damageDeposit === "Refunded" && (
            <>
              <div class="row">
                <dt>Amount kept back</dt>
                <dd>
                  <span class="value">
                    {tracking.damageKeptBack
                      ? `R ${tracking.damageKeptBack}`
                      : "Nothing"}
                  </span>
                </dd>
              </div>
              {tracking.damageNote && (
                <div class="row">
                  <dt>Damage</dt>
                  <dd>
                    <span class="value multiline">{tracking.damageNote}</span>
                  </dd>
                </div>
              )}
            </>
          )}
        </dl>
        {tracking.updatedAt !== null && (
          <p class="note">
            Last saved by {lastSavedBy || "someone"},{" "}
            {shortDateTime(tracking.updatedAt)}.
          </p>
        )}
      </section>

      {user.permissions.payments && (
        <PaymentsPanel
          bookingId={booking.id}
          invoice={invoice}
          payments={payments}
          tracking={booking.tracking}
        />
      )}
    </div>

    <div class="column">
      <section class="panel">
        <h2>From the booking form</h2>
        <dl class="rows">
          <div class="row">
            <dt>Special considerations</dt>
            <dd>
              <span class="value multiline">
                {booking.specialConsiderations || "None"}
              </span>
            </dd>
          </div>
          <div class="row">
            <dt>Club member</dt>
            <dd>
              <span class="value">{booking.isMember ? "Yes" : "No"}</span>
            </dd>
          </div>
          <div class="row">
            <dt>Terms and conditions</dt>
            <dd>
              <span class="value">
                {booking.acceptedTerms ? "Accepted" : "Not accepted"}
              </span>
            </dd>
          </div>
          {canDeleteIdNumbers && (
            <div class="row">
              <dt>ID number</dt>
              <dd class="id-number-cell">
                <span class="value">
                  {booking.idNumber
                    ? "On file in the spreadsheet"
                    : "Not on file"}
                </span>
                {showDeleteIdNumber && (
                  <details class="delete-id">
                    <summary>
                      <Icon name="trash" size={16} />
                      Delete ID number
                    </summary>
                    <div class="delete-id-confirm">
                      <p>
                        The club no longer needs it. This clears it from "Form
                        responses 1" and can't be undone. Google Forms keeps its
                        own copy of the response.
                      </p>
                      <form method="POST" action={actions.deleteIdNumber}>
                        <input
                          type="hidden"
                          name="bookingId"
                          value={booking.id}
                        />
                        <button class="button button-danger" type="submit">
                          Delete it permanently
                        </button>
                      </form>
                    </div>
                  </details>
                )}
              </dd>
            </div>
          )}
          <div class="row">
            <dt>Requested</dt>
            <dd>
              <span class="value">{submitted}</span>
            </dd>
          </div>
        </dl>
      </section>

      <BookingHistory
        bookingId={booking.id}
        entries={history}
        user={user}
        now={now}
        error={noteError}
      />
    </div>
  </div>

  <p class="visually-hidden" aria-live="polite" data-copy-status></p>
</article>

<script>
  // Opens the phone's share sheet, so the link can go to WhatsApp, email or
  // any other app. Browsers without one (some desktops) copy the link instead.
  const shareButton = document.querySelector<HTMLButtonElement>(
    "[data-share-booking]"
  );

  shareButton?.addEventListener("click", async () => {
    const { path, title } = shareButton.dataset;
    const url = new URL(path!, location.origin).href;

    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch (error) {
        // Closing the share sheet without picking an app isn't an error
        if ((error as Error).name !== "AbortError") throw error;
      }
      return;
    }

    await navigator.clipboard.writeText(url);
    const label = shareButton.querySelector("[data-share-label]")!;
    label.textContent = "Link copied";
    window.setTimeout(() => (label.textContent = "Share"), 1500);
  });
</script>

<style>
  .booking {
    display: grid;
    gap: 1rem;
  }

  /* Phones: the buttons sit in a row under the name, so the name gets the
     full width. Wider screens: beside it. */
  .heading {
    display: grid;
    gap: 1rem;
  }
  .heading h1 {
    margin: 0;
    font-size: 1.625rem;
  }
  .function {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 1.0625rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }
  .heading-buttons {
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    gap: 0.5rem;
  }
  /* Less padding, so Share, Decline and Edit fit in a row on small phones */
  .heading-buttons .button {
    padding: 0 0.75rem;
  }
  @media (min-width: 48rem) {
    .heading {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
    }
    .heading-buttons {
      flex: none;
      grid-auto-columns: auto;
    }
  }
  .declined {
    margin: 0;
  }
  /* Full width, like "Copy all contact details" above it */
  .contacted-form .button {
    width: 100%;
  }

  .columns,
  .column {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .when-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .when-row div {
    display: grid;
  }
  .add-to-calendar {
    display: grid;
    flex: none;
    place-items: center;
    width: var(--tap-size);
    height: var(--tap-size);
    margin-left: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    color: var(--color-primary);
  }
  .add-to-calendar:hover {
    border-color: var(--color-muted);
  }
  .when-row strong {
    font-size: 1.0625rem;
    font-variant-numeric: tabular-nums;
  }
  .when-row span {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .when-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-small);
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .rows {
    display: grid;
    margin: 0;
  }
  .row {
    display: grid;
    gap: 0.125rem;
    padding: 0.625rem 0;
    border-top: 1px solid var(--color-border);
  }
  .row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  dt {
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  dd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
  }
  .value {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  a.value {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .multiline {
    white-space: pre-line;
  }
  .note {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.8125rem;
  }

  .id-number-cell {
    flex-wrap: wrap;
  }
  .delete-id {
    flex: 1 1 100%;
  }
  .delete-id summary {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.25rem;
    color: var(--color-danger);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .delete-id summary::-webkit-details-marker {
    display: none;
  }
  .delete-id-confirm {
    display: grid;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: var(--radius-small);
    background: var(--color-danger-soft);
    color: var(--color-danger);
    font-size: 0.9375rem;
  }
  .delete-id-confirm p {
    margin: 0;
  }
  .button-danger {
    border-color: var(--color-danger);
    background: var(--color-danger);
    /* White on light mode's dark red, near-black on dark mode's light red */
    color: var(--color-surface);
  }

  /* Wider screens: two columns, and labels beside their values */
  @media (min-width: 56rem) {
    .heading h1 {
      font-size: 2rem;
    }
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .row {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      align-items: center;
      gap: 1rem;
    }
  }
</style>
