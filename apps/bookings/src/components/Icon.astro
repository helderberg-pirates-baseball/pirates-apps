    '<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/>',
};

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICONS[name]}
/>

<style>
  .icon {
    flex: none;
  }
</style>
