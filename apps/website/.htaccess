# The host's defaults let browsers reuse pages for a day and CSS for a week
# without asking the server, so visitors kept seeing old menus after a deploy.
# "no-cache" makes the browser check first; unchanged files still come back
# as a quick "304 Not Modified". Images keep the host's default caching.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php|css|js)$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>

# The fixtures page moved from fixtures.html to fixtures.php (which shows the
# schedule file we're sent below the site's menu); keep old links and bookmarks working
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^fixtures\.html$ fixtures.php [R=301,L]
</IfModule>
